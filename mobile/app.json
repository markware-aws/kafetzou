{
  "expo": {
    "name": "Kafetzou",
    "slug": "kafetzou",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "kafetzou",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0c0a1a"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.kafetzou.app",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "We need access to your photo library to select coffee cup images for reading.",
        "NSCameraUsageDescription": "Take a photo of your coffee cup for a reading."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0c0a1a"
      },
      "package": "com.kafetzou.app",
      "permissions": [
        "READ_EXTERNAL_STORAGE",
        "CAMERA"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "We need access to your photo library to select coffee cup images.",
          "cameraPermission": "Take a photo of your coffee cup for a reading."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "http://localhost:8000",
      "cognitoUserPoolId": "",
      "cognitoClientId": "",
      "eas": {
        "projectId": "your-eas-project-id"
      }
    }
  }
}
